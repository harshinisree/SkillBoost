# Copy this file to .env and fill in your own values. Never commit .env.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost/skillboost
TEST_DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost/skillboost_test
JWT_SECRET=replace-with-a-long-random-string
# Optional. Browser front ends allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:3000
# Optional. Defaults to "5 per minute".
LOGIN_RATE_LIMIT=5 per minute
# Optional. DEBUG, INFO, WARNING, or ERROR. Defaults to INFO.
LOG_LEVEL=INFO
